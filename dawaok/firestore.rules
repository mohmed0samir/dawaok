rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // المنتجات — عرض عام، والإضافة/التعديل من لوحة الأدمن (محمية بكلمة سر
    // على مستوى الواجهة فقط — راجع ملاحظة الأمان في README قبل الإطلاق الحقيقي)
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // إعدادات الأدمن (هاش كلمة السر) — قراءة فقط عشان صفحة admin.html تتحقق منها
    match /settings/{docId} {
      allow read: if true;
      allow update: if true; // تغيير كلمة السر من نفس الصفحة
      allow create, delete: if false;
    }

    // الطلبات — أي حد (زائر أو مسجل) يقدر ينشئ طلب، والأدمن يقرأ/يعدل الحالة
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if true; // تحديث الحالة من لوحة الأدمن
      allow delete: if true; // جرد الطلبات من لوحة الأدمن
    }

    // حسابات المندوبين التي ينشئها الأدمن من لوحة التحكم
    match /deliveryAgents/{agentId} {
      allow read, write: if true;
    }

    // بيانات المستخدم الشخصية — كل مستخدم يشوف ويعدل بياناته هو بس
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // عناوين المستخدم المحفوظة
      match /addresses/{addressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
